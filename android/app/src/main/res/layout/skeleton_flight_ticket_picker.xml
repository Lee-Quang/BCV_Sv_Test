<?xml version="1.0" encoding="utf-8"?>
<!-- Same geometry as the region/place pickers: 26dp icon, name and hint lines, trailing chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Skeleton.Card"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="14dp">
    <View style="@style/Skeleton.Circle" android:layout_width="26dp" android:layout_height="26dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
        <View style="@style/Skeleton.Line" android:layout_width="140dp" android:layout_height="14dp" />
        <View style="@style/Skeleton.Line" android:layout_width="170dp" android:layout_height="10dp"
            android:layout_marginTop="6dp" />
    </LinearLayout>
    <View style="@style/Skeleton.Line" android:layout_width="18dp" android:layout_height="18dp" />
</LinearLayout>
