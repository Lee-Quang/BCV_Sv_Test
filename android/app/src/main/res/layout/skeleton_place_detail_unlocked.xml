<?xml version="1.0" encoding="utf-8"?>
<!--
  Loading placeholder for unlockedContent ("Nội dung địa danh"): name (already known), "Đã khám
  phá" chip and region, 180dp gallery with caption, story, and the two highlight cards.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView android:id="@+id/skeletonName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/forest"
        android:textSize="32sp" android:textStyle="bold" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="40dp"
            android:background="@drawable/journey_status_chip_bg" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="20dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:contentDescription="@null" android:src="@drawable/ic_lock_open_outline"
                app:tint="@color/teal" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="Đã khám phá"
                android:textColor="@color/teal" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <View style="@style/Skeleton.Line" android:layout_width="110dp" android:layout_height="13dp"
            android:layout_marginStart="20dp" />
    </LinearLayout>

    <View style="@style/Skeleton.Block" android:layout_height="180dp" android:layout_marginTop="18dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <View style="@style/Skeleton.Line" android:layout_width="150dp" android:layout_height="13dp" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <View style="@style/Skeleton.Line" android:layout_width="28dp" android:layout_height="12dp" />
    </LinearLayout>

    <View style="@style/Skeleton.Line" android:layout_width="180dp" android:layout_height="18dp"
        android:layout_marginTop="24dp" />
    <View style="@style/Skeleton.Line" android:layout_width="match_parent" android:layout_height="13dp"
        android:layout_marginTop="14dp" />
    <View style="@style/Skeleton.Line" android:layout_width="match_parent" android:layout_height="13dp"
        android:layout_marginTop="11dp" />
    <View style="@style/Skeleton.Line" android:layout_width="220dp" android:layout_height="13dp"
        android:layout_marginTop="11dp" />

    <View style="@style/Skeleton.Line" android:layout_width="130dp" android:layout_height="18dp"
        android:layout_marginTop="26dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/place_highlight_warm_bg"
        android:orientation="vertical" android:padding="16dp">
        <View style="@style/Skeleton.Circle" android:layout_width="24dp" android:layout_height="24dp" />
        <View style="@style/Skeleton.Line" android:layout_width="100dp" android:layout_height="14dp"
            android:layout_marginTop="12dp" />
        <View style="@style/Skeleton.Line" android:layout_width="match_parent" android:layout_height="12dp"
            android:layout_marginTop="8dp" />
        <View style="@style/Skeleton.Line" android:layout_width="180dp" android:layout_height="12dp"
            android:layout_marginTop="7dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:background="@drawable/place_highlight_cool_bg"
        android:orientation="vertical" android:padding="16dp">
        <View style="@style/Skeleton.Circle" android:layout_width="24dp" android:layout_height="24dp" />
        <View style="@style/Skeleton.Line" android:layout_width="120dp" android:layout_height="14dp"
            android:layout_marginTop="12dp" />
        <View style="@style/Skeleton.Line" android:layout_width="230dp" android:layout_height="12dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</LinearLayout>
