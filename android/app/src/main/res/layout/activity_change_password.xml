<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab_screen_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_detail_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="Nhập mật khẩu hiện tại để xác nhận đây là bạn, rồi đặt mật khẩu mới."
                android:textColor="#6F8579"
                android:textSize="14sp" />

            <TextView
                style="@style/AuthFieldLabel"
                android:labelFor="@id/currentInput"
                android:text="Mật khẩu hiện tại" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/currentLayout"
                style="@style/AuthInputLayout"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/currentInput"
                    style="@style/AuthInput"
                    android:autofillHints="password"
                    android:hint="Nhập mật khẩu hiện tại"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/AuthFieldLabel"
                android:labelFor="@id/passwordInput"
                android:text="Mật khẩu mới" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordLayout"
                style="@style/AuthInputLayout"
                app:endIconMode="password_toggle"
                app:helperText="Mật khẩu cần 8–128 ký tự, có chữ và số."
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordInput"
                    style="@style/AuthInput"
                    android:autofillHints="newPassword"
                    android:hint="Nhập mật khẩu mới"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/AuthFieldLabel"
                android:labelFor="@id/confirmInput"
                android:text="Xác nhận mật khẩu mới" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/confirmLayout"
                style="@style/AuthInputLayout"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/confirmInput"
                    style="@style/AuthInput"
                    android:autofillHints="newPassword"
                    android:hint="Nhập lại mật khẩu mới"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/requestError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/error_red"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="Đổi mật khẩu"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/teal"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
