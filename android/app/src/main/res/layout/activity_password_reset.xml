<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="310dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/hero_description"
                android:scaleType="centerCrop"
                android:src="@drawable/auth_hero" />

            <View
                android:layout_width="match_parent"
                android:layout_height="329dp"
                android:background="@drawable/hero_shade" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="56dp"
                android:gravity="center"
                android:text="BƯỚC CHÂN VIỆT"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="18dp"
                android:layout_marginTop="42dp"
                android:background="@drawable/auth_back_circle"
                android:contentDescription="Quay lại"
                android:padding="12dp"
                android:rotation="180"
                android:src="@drawable/ic_arrow"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="36dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ĐI ĐỂ KHÁM PHÁ"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Lấy lại kết nối,\ntiếp bước khám phá."
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="-18dp"
            android:background="@drawable/auth_panel"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <View
                android:layout_width="22dp"
                android:layout_height="3dp"
                android:background="@color/orange" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="Khôi phục mật khẩu"
                android:textColor="@color/forest"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Nhập email đã đăng ký để nhận mã xác minh."
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/stepIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stepEmailLabel"
                        style="@style/PasswordResetStepLabel"
                        android:text="01 Email" />

                    <View
                        android:id="@+id/stepEmailBar"
                        style="@style/PasswordResetStepBar" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stepCodeLabel"
                        style="@style/PasswordResetStepLabel"
                        android:text="02 Xác minh" />

                    <View
                        android:id="@+id/stepCodeBar"
                        style="@style/PasswordResetStepBar" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stepPasswordLabel"
                        style="@style/PasswordResetStepLabel"
                        android:text="03 Mật khẩu mới" />

                    <View
                        android:id="@+id/stepPasswordBar"
                        style="@style/PasswordResetStepBar" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stepContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- Step 1: email -->
                <LinearLayout
                    android:id="@+id/emailGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AuthFieldLabel"
                        android:text="Email" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/emailLayout"
                        style="@style/AuthInputLayout"
                        app:helperText="Sử dụng địa chỉ email đã đăng ký tài khoản."
                        app:startIconDrawable="@drawable/ic_mail">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/emailInput"
                            style="@style/AuthInput"
                            android:autofillHints="emailAddress"
                            android:hint="Nhập địa chỉ email"
                            android:imeOptions="actionDone"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Step 2: verification code -->
                <LinearLayout
                    android:id="@+id/codeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/AuthFieldLabel"
                        android:text="Mã xác minh" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/codeLayout"
                        style="@style/AuthInputLayout"
                        app:counterEnabled="false"
                        app:helperText="Mã gồm 6 chữ số, hiệu lực trong 10 phút."
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/codeInput"
                            style="@style/AuthInput"
                            android:autofillHints="smsOTPCode"
                            android:hint="Nhập mã 6 chữ số"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:letterSpacing="0.3"
                            android:maxLength="6" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Chưa nhận được mã?"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/resendButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:minHeight="40dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="6dp"
                            android:text="Gửi lại mã"
                            android:textColor="@color/teal"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Step 3: new password -->
                <LinearLayout
                    android:id="@+id/passwordGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/AuthFieldLabel"
                        android:text="Mật khẩu mới" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordLayout"
                        style="@style/AuthInputLayout"
                        app:endIconDrawable="@drawable/ic_visibility"
                        app:endIconMode="custom"
                        app:helperText="Mật khẩu cần 8–128 ký tự, có chữ và số."
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/passwordInput"
                            style="@style/AuthInput"
                            android:autofillHints="newPassword"
                            android:hint="Nhập mật khẩu mới"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/AuthFieldLabel"
                        android:text="Xác nhận mật khẩu" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/confirmLayout"
                        style="@style/AuthInputLayout"
                        app:endIconDrawable="@drawable/ic_visibility"
                        app:endIconMode="custom"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/confirmInput"
                            style="@style/AuthInput"
                            android:autofillHints="newPassword"
                            android:hint="Nhập lại mật khẩu mới"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Done -->
                <LinearLayout
                    android:id="@+id/doneGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/doneIcon"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:background="@drawable/success_circle"
                        android:contentDescription="@string/success_description">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:background="@drawable/success_check_inner"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="Đã đặt lại mật khẩu!"
                        android:textColor="@color/forest"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="Dùng mật khẩu mới để đăng nhập.\nCác phiên đăng nhập cũ đã được đăng xuất."
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/success_note_bg"
                android:padding="10dp"
                android:textColor="@color/forest"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/requestError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:background="#FFF1EF"
                android:padding="10dp"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submitButton"
                    style="@style/AuthButton"
                    android:text="Gửi mã xác minh"
                    app:icon="@drawable/ic_arrow"
                    app:iconGravity="end" />

                <LinearLayout
                    android:id="@+id/submitLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="8dp"
                        android:indeterminate="true"
                        app:indicatorColor="@color/teal"
                        app:indicatorSize="24dp"
                        app:trackColor="@color/auth_loading_track"
                        app:trackThickness="3dp" />

                    <TextView
                        android:id="@+id/submitLoadingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang gửi mã..."
                        android:textColor="@color/auth_loading_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/backToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:minHeight="44dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Quay lại đăng nhập"
                android:textColor="@color/teal"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
