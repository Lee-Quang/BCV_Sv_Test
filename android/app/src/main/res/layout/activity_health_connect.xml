<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Health Connect"
            android:textColor="@color/forest"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp"
            android:background="@drawable/activity_back_circle"
            android:contentDescription="Quay lại mức vận động"
            android:padding="12dp"
            android:rotation="180"
            android:src="@drawable/ic_arrow"
            app:tint="@color/forest" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="154dp"
                android:importantForAccessibility="no">

                <FrameLayout
                    android:id="@+id/initialHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="154dp"
                        android:layout_height="154dp"
                        android:layout_gravity="center"
                        android:background="@drawable/health_orbit_bg" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|right"
                        android:layout_marginTop="32dp"
                        android:layout_marginEnd="52dp"
                        android:background="@drawable/health_circle_bg"
                        android:backgroundTint="@color/orange" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="76dp"
                                android:layout_height="76dp"
                                android:background="@drawable/health_icon_box_bg">

                                <ImageView
                                    android:layout_width="33dp"
                                    android:layout_height="33dp"
                                    android:layout_gravity="center"
                                    android:contentDescription=""
                                    android:src="@drawable/ic_directions_walk"
                                    app:tint="#426A50" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="Health Connect"
                                android:textColor="#738C77"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginEnd="15dp"
                            android:layout_marginBottom="18dp"
                            android:contentDescription=""
                            android:src="@drawable/ic_arrow"
                            app:tint="#80A282" />

                        <LinearLayout
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="76dp"
                                android:layout_height="76dp"
                                android:background="@drawable/health_icon_box_app_bg">

                                <ImageView
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:layout_gravity="center"
                                    android:contentDescription=""
                                    android:src="@drawable/ic_health_link" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="Bước Chân Việt"
                                android:textColor="#738C77"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/stateHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <View
                        android:id="@+id/stateOrbit"
                        android:layout_width="152dp"
                        android:layout_height="152dp"
                        android:layout_gravity="center"
                        android:background="@drawable/health_orbit_bg" />

                    <FrameLayout
                        android:id="@+id/stateIconCircle"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_gravity="center"
                        android:background="@drawable/health_circle_bg">

                        <ImageView
                            android:id="@+id/stateIcon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription=""
                            android:src="@drawable/ic_check"
                            app:tint="@color/white" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/stateSpinner"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/white"
                            app:indicatorSize="44dp"
                            app:trackColor="#9DCABB"
                            app:trackThickness="4dp" />
                    </FrameLayout>
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="18dp"
                    android:layout_height="3dp"
                    android:layout_marginEnd="8dp"
                    android:background="@color/orange" />

                <TextView
                    android:id="@+id/eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BƯỚC CHÂN THÀNH HÀNH TRÌNH"
                    android:textColor="#728B74"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/headlineTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Biến bước chân"
                android:textColor="@color/forest"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/headlineAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="thành hành trình."
                android:textColor="@color/teal"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="Cho phép đọc số bước từ Health Connect và đồng bộ để cập nhật tiến độ hành trình."
                android:textColor="#748B78"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/detailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/health_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <FrameLayout
                    android:id="@+id/detailIconBox"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/health_icon_box_bg">

                    <ImageView
                        android:id="@+id/detailIcon"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:contentDescription=""
                        android:src="@drawable/ic_directions_walk"
                        app:tint="@color/teal" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/detailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Số bước chân"
                        android:textColor="@color/forest"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detailBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Số bước cùng thời gian ghi nhận."
                        android:textColor="#748B78"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/detailFootnote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Bước này chỉ xin quyền đọc Health Connect"
                        android:textColor="@color/teal"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/privacyRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_health_shield" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/privacyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chỉ truy cập sau khi bạn cho phép."
                        android:textColor="#496E58"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/privacyBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Có thể thu hồi quyền trong Health Connect."
                        android:textColor="#849B88"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/health_warning_bg"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:text="Nếu để sau, các chức năng cần bước chân sẽ chưa sử dụng được."
                android:textColor="#9D753F"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="5dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/primaryButton"
            style="@style/AuthButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Cho phép đọc bước chân"
            app:icon="@drawable/ic_arrow"
            app:iconGravity="end" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secondaryButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Để sau"
            android:textAllCaps="false"
            android:textColor="#557B62"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="15dp"
            app:strokeColor="#BFD7C4"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Bạn sẽ xác nhận quyền trên màn hình hệ thống."
            android:textColor="#849B88"
            android:textSize="10sp" />

    </LinearLayout>
</LinearLayout>
