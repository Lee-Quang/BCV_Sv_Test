<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab_screen_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BƯỚC CHÂN VIỆT"
                android:textColor="@color/teal"
                android:textSize="10sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khám phá"
                    android:textColor="@color/forest"
                    android:textSize="27sp"
                    android:textStyle="bold" />
                <!-- Demo helper: writes 2,000 sample steps to Health Connect to try syncing. -->
                <ImageButton
                    android:id="@+id/demoStepsButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/demo_steps_button_bg"
                    android:contentDescription="Thêm 2.000 bước chân mẫu vào Health Connect để thử đồng bộ"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_demo_steps"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/notificationsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/explore_header_circle"
            android:contentDescription="Thông báo"
            android:padding="13dp"
            android:src="@drawable/ic_explore_bell" />
        <!-- The user's avatar when one is set; the person icon otherwise (or until it loads). -->
        <FrameLayout
            android:id="@+id/profileButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/health_icon_box_bg"
            android:clickable="true"
            android:contentDescription="Hồ sơ"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/profileIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/ic_explore_person" />
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profileAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/AvatarCircle" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#EAF2E8">

        <FrameLayout
            android:id="@+id/mapHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/locationCard"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/starting_point_card_bg"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/health_icon_box_bg"
                android:contentDescription=""
                android:padding="8dp"
                android:src="@drawable/ic_starting_pin"
                app:tint="@color/teal" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VỊ TRÍ ẢO HIỆN TẠI"
                    android:textColor="#718A78"
                    android:textSize="8sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/locationName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Đang tải..."
                    android:textColor="@color/forest"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="Vị trí đã được lưu"
                android:src="@drawable/ic_health_shield"
                app:tint="#8AAA8B" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/recenterButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/starting_point_card_bg"
            android:contentDescription="Về vị trí ảo"
            android:elevation="4dp"
            android:padding="11dp"
            android:src="@drawable/ic_starting_target"
            app:tint="@color/teal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/starting_point_card_bg"
            android:paddingStart="9dp"
            android:paddingTop="2dp"
            android:paddingEnd="9dp"
            android:paddingBottom="2dp"
            android:text="© Goong Maps"
            android:textColor="#819387"
            android:textSize="8sp" />

        <LinearLayout
            android:id="@+id/mapLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EEF5F3F1"
            android:gravity="center"
            android:orientation="vertical">
            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/teal" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Đang tải bản đồ khám phá"
                android:textColor="@color/forest"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mapFailure"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFF8F5F2"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/health_warning_bg"
                android:contentDescription=""
                android:padding="16dp"
                android:src="@drawable/ic_starting_map"
                app:tint="#C36E59" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Chưa tải được bản đồ khám phá"
                android:textColor="@color/forest"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Kiểm tra kết nối và thử tải lại."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/starting_point_sheet_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="9dp">
        <FrameLayout
            android:id="@+id/sheetHandleArea"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:contentDescription="Kéo để mở rộng hoặc thu gọn thông tin khám phá">
            <View
                android:layout_width="44dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal|top"
                android:background="#DFE8DD" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/explore_notice_bg"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingTop="8dp"
            android:paddingEnd="15dp"
            android:paddingBottom="8dp">
            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đang tải dữ liệu khám phá"
                android:textColor="@color/teal"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/statusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Vui lòng chờ trong giây lát."
                android:textColor="@color/teal"
                android:textSize="10sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/sheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Điểm đến đang chờ bạn."
            android:textColor="@color/forest"
            android:textSize="25sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/sheetDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hiện chưa có hành trình đang thực hiện."
            android:textColor="#758A7F"
            android:textSize="12sp" />
        <LinearLayout
            android:id="@+id/progressSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/stepsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/forest"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/stepsTotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textColor="#6F8579"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/progressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/teal"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/journeyProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:indicatorColor="@color/teal"
                app:trackColor="#E3EBE3"
                app:trackCornerRadius="4dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="8dp" />
            <TextView
                android:id="@+id/progressCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="#7C9086"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/primaryButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Gợi ý điểm đến"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/teal"
                app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/secondaryButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:minWidth="96dp"
                android:paddingHorizontal="16dp"
                android:text="Đồng bộ"
                android:textAllCaps="false"
                android:textColor="@color/teal"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="16dp"
                app:strokeColor="#D6E3DA" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tertiaryButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Gợi ý điểm đến khác"
            android:textAllCaps="false"
            android:textColor="@color/teal"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:strokeColor="#D6E3DA" />
        <TextView
            android:id="@+id/sheetFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Gợi ý được tìm từ vị trí ảo hiện tại."
            android:textColor="#819387"
            android:textSize="10sp" />
    </LinearLayout>
    </FrameLayout>
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp" />
</LinearLayout>
