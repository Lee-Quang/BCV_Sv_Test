<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab_screen_bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/contentScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BƯỚC CHÂN VIỆT"
                            android:textColor="@color/teal"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="Hành trình"
                            android:textColor="@color/forest"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/statusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/journey_status_chip_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="22dp"
                        android:visibility="gone">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/journey_status_dot" />

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Đang đi"
                            android:textColor="@color/teal"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Loading: the destination, progress and map cards below as pulsing placeholders. -->
                <include android:id="@+id/journeyLoading" layout="@layout/skeleton_journey_detail" />

                <LinearLayout
                    android:id="@+id/journeyContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Destination -->
                    <LinearLayout
                        android:id="@+id/destinationCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/journey_card_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/journey_destination_icon_bg"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            android:src="@drawable/ic_flag_outline"
                            app:tint="#A36A2A" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ĐIỂM ĐẾN"
                                android:textColor="#7C9086"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/destinationName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/forest"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/unlockIcon"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_lock"
                                    app:tint="#8FA196" />

                                <TextView
                                    android:id="@+id/unlockText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="Chưa mở khóa"
                                    android:textColor="#7C9086"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Shown once the place is unlocked: the card then opens its content. -->
                        <ImageView
                            android:id="@+id/destinationChevron"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            android:visibility="gone"
                            app:tint="@color/teal" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/startLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:padding="12dp"
                        android:background="@drawable/destination_locked_bg"
                        android:textColor="@color/forest"
                        android:textSize="14sp" />

                    <!-- Progress -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/journey_progress_card_bg">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="18dp"
                            android:gravity="end"
                            android:importantForAccessibility="no"
                            android:orientation="vertical">

                            <View
                                android:layout_width="50dp"
                                android:layout_height="8dp"
                                android:background="@drawable/journey_deco_bar" />

                            <View
                                android:layout_width="26dp"
                                android:layout_height="8dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/journey_deco_bar" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/progressCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TIẾN ĐỘ HÀNH TRÌNH"
                                android:textColor="#CCFFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:baselineAligned="true"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/stepsCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/white"
                                    android:textSize="38sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/stepsTotal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:textColor="#D9FFFFFF"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <FrameLayout
                                android:id="@+id/progressBar"
                                android:layout_width="match_parent"
                                android:layout_height="14dp"
                                android:layout_marginTop="12dp"
                                android:importantForAccessibility="no">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="8dp"
                                    android:layout_gravity="center_vertical"
                                    android:background="@drawable/journey_progress_track" />

                                <View
                                    android:id="@+id/progressFill"
                                    android:layout_width="0dp"
                                    android:layout_height="8dp"
                                    android:layout_gravity="center_vertical"
                                    android:background="@drawable/journey_progress_fill" />

                                <View
                                    android:id="@+id/progressThumb"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:background="@drawable/journey_progress_thumb" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/percentValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/white"
                                        android:textSize="26sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Đã hoàn thành"
                                        android:textColor="#D9FFFFFF"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginVertical="2dp"
                                    android:background="#4DFFFFFF" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="18dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/remainingValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/white"
                                        android:textSize="26sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Bước còn lại"
                                        android:textColor="#D9FFFFFF"
                                        android:textSize="13sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_health_shield"
                                    app:tint="#D9FFFFFF" />

                                <TextView
                                    android:id="@+id/syncedText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:textColor="#D9FFFFFF"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>

                    <com.project.bcv.core.ui.ActiveItemBanner
                        android:id="@+id/activeItemBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />

                    <!-- Map -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:accessibilityHeading="true"
                        android:text="Vị trí trên hành trình"
                        android:textColor="@color/forest"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="#ECEFE8"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E2E8DF"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:id="@+id/mapHost"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="noHideDescendants" />

                        <!-- Above the (gesture-less) map so a tap anywhere on the card opens Khám phá. -->
                        <View
                            android:id="@+id/mapTapTarget"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:contentDescription="Bản đồ hành trình từ vị trí ảo tới điểm đến. Mở trên màn Khám phá"
                            android:focusable="true" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/JourneyLegend"
                            android:drawableStart="@drawable/ic_legend_virtual"
                            android:text="Vị trí ảo" />

                        <TextView
                            style="@style/JourneyLegend"
                            android:drawableStart="@drawable/ic_legend_walker"
                            android:text="Theo tiến độ" />

                        <TextView
                            style="@style/JourneyLegend"
                            android:drawableStart="@drawable/ic_legend_flag"
                            android:text="Điểm đến" />
                    </LinearLayout>

                    <!-- Notes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/journey_info_box_bg"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/noteLocation"
                            style="@style/JourneyNote"
                            android:drawableStart="@drawable/ic_note_pin"
                            android:text="Vị trí ảo chỉ đổi khi hoàn thành." />

                        <TextView
                            android:id="@+id/noteContent"
                            style="@style/JourneyNote"
                            android:layout_marginTop="10dp"
                            android:drawableStart="@drawable/ic_note_lock"
                            android:text="Ảnh và nội dung vẫn đang được khóa." />
                    </LinearLayout>
                </LinearLayout>

                <!-- Loading / empty / error -->
                <LinearLayout
                    android:id="@+id/messageState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/journey_card_bg"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/messageProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorColor="@color/teal"
                        app:indicatorSize="36dp" />

                    <ImageView
                        android:id="@+id/messageIcon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/journey_destination_icon_bg"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:src="@drawable/ic_nav_route"
                        app:tint="#A36A2A" />

                    <TextView
                        android:id="@+id/messageTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:textColor="@color/forest"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/messageBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        android:textColor="#7C9086"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/messageButton"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/teal"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp" />
</LinearLayout>
