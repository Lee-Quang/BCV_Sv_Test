<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@color/white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="310dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/hero_description"
                android:src="@drawable/auth_hero" />

            <View
                android:layout_width="match_parent"
                android:layout_height="329dp"
                android:background="@drawable/hero_shade" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="44dp"
                android:gravity="center"
                android:text="BƯỚC CHÂN VIỆT"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/authBackButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="24dp"
                android:layout_marginTop="44dp"
                android:background="@drawable/auth_back_circle"
                android:contentDescription="Quay lại"
                android:padding="12dp"
                android:rotation="180"
                android:src="@drawable/ic_arrow"
                android:visibility="gone"
                app:tint="@color/white" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="36dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ĐI ĐỂ KHÁM PHÁ"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/heroHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/login_hero_headline"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="-18dp"
            android:background="@drawable/auth_panel"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">
            <View
                android:layout_width="22dp"
                android:layout_height="3dp"
                android:background="@color/orange" />
            <LinearLayout
                android:id="@+id/formContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/formTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/login_title"
                    android:textColor="@color/forest"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/formSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/login_subtitle"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
                <TextView
                    style="@style/AuthFieldLabel"
                    android:layout_marginTop="12dp"
                    android:text="Email" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    style="@style/AuthInputLayout"
                    app:startIconDrawable="@drawable/ic_mail">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailInput"
                        style="@style/AuthInput"
                        android:hint="Nhập địa chỉ email"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/AuthFieldLabel"
                    android:layout_marginTop="0dp"
                    android:text="Mật khẩu" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordLayout"
                    style="@style/AuthInputLayout"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_visibility"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordInput"
                        style="@style/AuthInput"
                        android:hint="Nhập mật khẩu"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:id="@+id/confirmGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:orientation="vertical">
                    <TextView
                        style="@style/AuthFieldLabel"
                        android:layout_marginTop="0dp"
                        android:text="Xác nhận mật khẩu" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/confirmLayout"
                        style="@style/AuthInputLayout"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_visibility"
                        app:startIconDrawable="@drawable/ic_lock">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/confirmInput"
                            style="@style/AuthInput"
                            android:hint="Nhập lại mật khẩu"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/forgotPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:paddingVertical="5dp"
                    android:text="@string/forgot_password"
                    android:textColor="@color/teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="visible" />
                <TextView
                    android:id="@+id/requestError"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:background="#FFF1EF"
                    android:gravity="center_vertical"
                    android:maxLines="2"
                    android:padding="3dp"
                    android:textColor="@color/error_red"
                    android:textSize="10sp"
                    android:visibility="invisible" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submitButton"
                        style="@style/AuthButton"
                        android:text="Đăng nhập"
                        app:icon="@drawable/ic_arrow"
                        app:iconGravity="textEnd" />
                    <LinearLayout
                        android:id="@+id/submitLoadingContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/submitProgress"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:indeterminate="true"
                            app:indicatorColor="@color/teal"
                            app:indicatorSize="24dp"
                            app:trackColor="@color/auth_loading_track"
                            app:trackThickness="3dp" />

                        <TextView
                            android:id="@+id/submitLoadingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đang đăng nhập..."
                            android:textColor="@color/auth_loading_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/switchPrompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa có tài khoản?"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/switchMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="7dp"
                        android:text="Đăng ký"
                        android:textColor="@color/teal"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/successContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="22dp"
                android:visibility="gone">
                <FrameLayout
                    android:id="@+id/successIcon"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:background="@drawable/success_circle"
                    android:contentDescription="@string/success_description">

                    <ImageView
                        android:id="@+id/successCheck"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:background="@drawable/success_check_inner"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/white" />
                </FrameLayout>
                <TextView
                    android:id="@+id/successTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="Đăng ký thành công!"
                    android:textColor="@color/forest"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/successMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Chào mừng bạn đến với Bước Chân Việt.&#10;Tài khoản của bạn đã sẵn sàng."
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/success_note_bg"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/successNoteTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cá nhân hóa hành trình của bạn"
                        android:textColor="@color/forest"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/successNoteBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Tiếp theo, thiết lập sở thích và mức vận động để nhận gợi ý khám phá phù hợp."
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/successButton"
                    style="@style/AuthButton"
                    android:layout_marginTop="24dp"
                    android:text="Tiếp tục thiết lập"
                    app:icon="@drawable/ic_arrow"
                    app:iconGravity="textEnd" />

                <TextView
                    android:id="@+id/successFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Hành trình khám phá đang chờ bạn."
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
