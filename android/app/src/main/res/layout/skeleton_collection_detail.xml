<?xml version="1.0" encoding="utf-8"?>
<!-- Loading placeholder for the content of activity_collection_detail: owned summary card,
     section heading and a first screen of the two-column card grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="Đang tải thẻ"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:background="@drawable/collection_summary_bg"
        android:orientation="vertical" android:padding="16dp">
        <View style="@style/Skeleton.Line" android:layout_width="72dp" android:layout_height="10dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <View style="@style/Skeleton.Line" android:layout_width="120dp" android:layout_height="26dp" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <View style="@style/Skeleton.Line" android:layout_width="52dp" android:layout_height="20dp" />
        </LinearLayout>
        <View style="@style/Skeleton.Line" android:layout_width="match_parent" android:layout_height="8dp"
            android:layout_marginTop="14dp" />
    </LinearLayout>

    <View style="@style/Skeleton.Line" android:layout_width="180dp" android:layout_height="16dp"
        android:layout_marginTop="26dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:orientation="horizontal">
        <include layout="@layout/skeleton_collection_detail_card" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <include layout="@layout/skeleton_collection_detail_card" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <include layout="@layout/skeleton_collection_detail_card" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <include layout="@layout/skeleton_collection_detail_card" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <include layout="@layout/skeleton_collection_detail_card" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <include layout="@layout/skeleton_collection_detail_card" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <include layout="@layout/skeleton_collection_detail_card" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <include layout="@layout/skeleton_collection_detail_card" />
    </LinearLayout>
</LinearLayout>
