<?xml version="1.0" encoding="utf-8"?>
<!--
  Loading placeholder for activity_recommendation: the same paddings and margins, the location pill,
  the heading rows at their real text sizes and three item_recommendation-sized cards, so nothing
  moves when the results replace it.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:contentDescription="Đang tìm điểm đến phù hợp"
    android:fillViewport="true"
    android:scrollbars="none"
    android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="8dp"
        android:paddingEnd="20dp" android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:background="@drawable/recommendation_location_bg" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="16dp">
            <View style="@style/Skeleton.Circle" android:layout_width="22dp" android:layout_height="22dp" />
            <View style="@style/Skeleton.Line" android:layout_width="86dp" android:layout_height="12dp"
                android:layout_marginStart="12dp" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <View style="@style/Skeleton.Line" android:layout_width="120dp" android:layout_height="13dp" />
        </LinearLayout>

        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <TextView style="@style/Skeleton.TextRow" android:text="Điểm đến dành cho bạn"
                android:textSize="27sp" />
            <View style="@style/Skeleton.TextBar" android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp" />
        </FrameLayout>
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <TextView style="@style/Skeleton.TextRow" android:text="3 gợi ý phù hợp từ vị trí ảo hiện tại"
                android:textSize="14sp" android:textStyle="normal" />
            <View style="@style/Skeleton.TextBar" />
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="vertical">
            <include layout="@layout/skeleton_item_recommendation" />
            <include layout="@layout/skeleton_item_recommendation" />
            <include layout="@layout/skeleton_item_recommendation" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
