<?xml version="1.0" encoding="utf-8"?>
<!-- Loading placeholder for the account card of activity_profile: 58dp avatar, name, email and status chip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_bg"
    android:backgroundTint="#E8F0E2"
    android:contentDescription="Đang tải hồ sơ"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <View style="@style/Skeleton.Circle" android:layout_width="58dp" android:layout_height="58dp"
            android:background="@drawable/skeleton_card" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <View style="@style/Skeleton.Line" android:layout_width="150dp" android:layout_height="18dp"
                android:background="@drawable/skeleton_card" />
            <View style="@style/Skeleton.Line" android:layout_width="190dp" android:layout_height="10dp"
                android:layout_marginTop="8dp" android:background="@drawable/skeleton_card" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/Skeleton.Block" android:layout_height="30dp" android:layout_marginTop="14dp"
        android:background="@drawable/skeleton_card" />
</LinearLayout>
