<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab_screen_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_detail_top_bar" />

    <include
        android:id="@+id/state"
        layout="@layout/view_screen_state" />

    <include
        android:id="@+id/skeleton"
        layout="@layout/skeleton_speed_shoes" />

    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_bg"
                android:backgroundTint="#167A5F"
                android:padding="18dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/inventory_hero_icon_bg"
                    android:backgroundTint="#3A9479"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_sneaker"
                    app:tint="#E3F2E6" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="76dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MỖI BƯỚC, TIẾN XA HƠN"
                        android:textColor="#CCFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/multiplier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/white"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="bước tính vào tiến độ"
                        android:textColor="#E6FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/ownedChip"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/chip_bg"
                        android:backgroundTint="#2C8A6E"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:accessibilityHeading="true"
                android:text="Hiệu ứng vật phẩm"
                android:textColor="@color/forest"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/journey_card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hệ số bước"
                        android:textColor="#6F8579"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/factorValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/teal"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Phạm vi hiệu lực"
                        android:textColor="#6F8579"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/rangeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/forest"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/effectNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="#7C9086"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/journeyPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/panel_bg"
                android:backgroundTint="#E8F0E2"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/journeyLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_nav_route"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/teal"
                    android:gravity="center_vertical"
                    android:textColor="@color/forest"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/journeyName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/forest"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/journeyCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="#6F8579"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="6dp"
                android:text="Chỉ dùng 1 giày khi kích hoạt thành công.\nKhông tự cộng bước hoặc hoàn thành hành trình."
                android:textColor="#6F8579"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/useButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToInventory"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:text="Quay lại kho"
                android:textAllCaps="false"
                android:textColor="@color/teal"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="@color/teal" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
