<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab_screen_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_detail_top_bar" />

    <include
        android:id="@+id/state"
        layout="@layout/view_screen_state" />

    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/avatarFrame"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal">

                <TextView
                    android:id="@+id/avatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/panel_bg"
                    android:backgroundTint="#E8F0E2"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/teal"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatarImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Ảnh đại diện"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearance="@style/AvatarShape" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changeAvatar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:minWidth="180dp"
                android:text="Đổi ảnh đại diện"
                android:textAllCaps="false"
                android:textColor="@color/teal"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="@color/teal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:labelFor="@id/nameInput"
                android:text="Họ và tên"
                android:textColor="@color/forest"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/teal"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="100"
                    android:minHeight="56dp"
                    android:textColor="@color/forest"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Email đăng nhập"
                android:textColor="@color/forest"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emailValue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/panel_bg"
                android:backgroundTint="#EFF1ED"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/forest"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Email chỉ hiển thị, không chỉnh sửa tại đây."
                android:textColor="#7C9086"
                android:textSize="12sp" />

            <include
                android:id="@+id/passwordLink"
                layout="@layout/item_profile_link" />

            <LinearLayout
                android:id="@+id/statusPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/panel_bg"
                android:backgroundTint="#E8F0E2"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:drawableStart="@drawable/ic_info_outline"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/forest"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#6F8579"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="Lưu thay đổi"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
