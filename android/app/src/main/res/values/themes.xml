<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.BướcChânViệt" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowAnimationStyle">@style/BcvScreenAnimations</item>
    </style>

    <style name="BcvScreenAnimations">
        <item name="android:activityOpenEnterAnimation">@anim/screen_forward_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_forward_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_back_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_back_exit</item>
    </style>

    <style name="Theme.BướcChânViệt" parent="Base.Theme.BướcChânViệt" />
</resources>
