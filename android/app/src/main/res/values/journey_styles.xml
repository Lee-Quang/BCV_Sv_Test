<resources>
    <style name="JourneyLegend">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#5F7468</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="JourneyNote">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#5F7468</item>
        <item name="android:textSize">13sp</item>
    </style>
    <!-- Bottom navigation tab, matching the inline tabs of activity_explore. -->
    <style name="NavTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="NavTabIcon">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:scaleType">center</item>
    </style>
    <style name="NavTabLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textColor">#7D8A82</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Rounded square used for avatars, matching the initials tile behind it. -->
    <style name="AvatarShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="AvatarCircle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
